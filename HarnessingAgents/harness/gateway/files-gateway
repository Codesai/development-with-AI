#!/usr/bin/env node
//
// files-gateway - the workspace file interface for the HarnessingAgents "Gateways" exercise.
//
// When copilot is launched through ../copilot-gated.js, the raw file tools
// (cat, ls, find, grep, and the native view/glob/grep) are banned and this is
// the only way the agent can list, read, or search files. It is confined to
// FILES_GATEWAY_ROOT (the directory copilot was launched from) and it hides a
// fixed set of sensitive paths - a missing file and a hidden file give the
// identical error, so the agent cannot even confirm a secret exists.
//
//   files-gateway ls [dir]                list a directory (relative paths)
//   files-gateway read <file>             print a file
//   files-gateway grep <pattern> [path]   search file contents

import fs from 'node:fs';
import path from 'node:path';

const DEFAULT_HIDDEN_PATTERNS = [
  'config/credentials.json', '*credential*', '*secret*', '.env', '.env.*',
  '*.pem', '*.key', '*.p12', '*.pfx', 'id_rsa*', '*token*',
];

class NoSuchFileError extends Error {}

function usageError() {
  process.stderr.write('usage: files-gateway (ls [dir] | read <file> | grep <pattern> [path])\n');
  process.exit(2);
}

function resolveRoot() {
  const requestedRoot = process.env.FILES_GATEWAY_ROOT || process.cwd();
  let root;
  try {
    root = fs.realpathSync(requestedRoot);
  } catch {
    root = null;
  }
  if (!root || !fs.statSync(root).isDirectory()) {
    process.stderr.write('files-gateway: FILES_GATEWAY_ROOT is not a directory\n');
    process.exit(1);
  }
  return root;
}

function loadHiddenPatterns() {
  const raw = process.env.FILES_GATEWAY_HIDDEN || DEFAULT_HIDDEN_PATTERNS.join(':');
  return raw.split(':');
}

// Rejects absolute paths and any attempt to climb above ROOT via "..", then
// joins with ROOT and (if the target exists) resolves symlinks so a link
// cannot be used to point back outside ROOT either.
function resolveWithinRoot(root, requestedPath) {
  const climbsOutOfRoot = requestedPath.startsWith('/')
    || requestedPath === '..'
    || requestedPath.startsWith('../')
    || requestedPath.endsWith('/..')
    || requestedPath.includes('/../');
  if (climbsOutOfRoot) throw new NoSuchFileError(requestedPath);

  let absolutePath = path.join(root, requestedPath);
  if (fs.existsSync(absolutePath)) {
    absolutePath = fs.realpathSync(absolutePath);
  }

  const staysWithinRoot = absolutePath === root || absolutePath.startsWith(root + path.sep);
  if (!staysWithinRoot) throw new NoSuchFileError(requestedPath);
  return absolutePath;
}

function matchesGlob(text, pattern) {
  const regexSource = [...pattern].map((ch) => {
    if (ch === '*') return '.*';
    if (ch === '?') return '.';
    return ch.replace(/[.+^${}()|[\]\\]/g, '\\$&');
  }).join('');
  return new RegExp(`^${regexSource}$`).test(text);
}

function isHiddenPath(relativePath, hiddenPatterns) {
  const baseName = path.basename(relativePath);
  return hiddenPatterns.some((pattern) => matchesGlob(relativePath, pattern) || matchesGlob(baseName, pattern));
}

function byName(a, b) {
  return a.name < b.name ? -1 : a.name > b.name ? 1 : 0;
}

function* walkFiles(dir) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true }).sort(byName)) {
    if (entry.name === '.git') continue;
    const entryPath = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      yield* walkFiles(entryPath);
    } else if (entry.isFile()) {
      yield entryPath;
    }
  }
}

function listDirectory(root, hiddenPatterns, requested) {
  const dir = resolveWithinRoot(root, requested);
  if (!fs.statSync(dir).isDirectory()) throw new NoSuchFileError(requested);

  const lines = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true }).sort(byName)) {
    if (entry.name === '.git') continue;
    const relativePath = path.relative(root, path.join(dir, entry.name));
    if (isHiddenPath(relativePath, hiddenPatterns)) continue;
    lines.push(entry.isDirectory() ? `${relativePath}/` : relativePath);
  }
  return lines;
}

function readFile(root, hiddenPatterns, requested) {
  const filePath = resolveWithinRoot(root, requested);
  const relativePath = path.relative(root, filePath);
  const isVisibleFile = fs.existsSync(filePath) && fs.statSync(filePath).isFile() && !isHiddenPath(relativePath, hiddenPatterns);
  if (!isVisibleFile) throw new NoSuchFileError(requested);
  return fs.readFileSync(filePath, 'utf8');
}

function grepFiles(root, hiddenPatterns, pattern, requested) {
  const base = resolveWithinRoot(root, requested);
  if (!fs.existsSync(base)) throw new NoSuchFileError(requested);

  let regex;
  try {
    regex = new RegExp(pattern);
  } catch {
    return []; // an invalid pattern matches nothing, same as grep exiting quietly
  }

  const hits = [];
  for (const filePath of walkFiles(base)) {
    const relativePath = path.relative(root, filePath);
    if (isHiddenPath(relativePath, hiddenPatterns)) continue;
    fs.readFileSync(filePath, 'utf8').split('\n').forEach((line, index) => {
      if (regex.test(line)) hits.push(`${relativePath}:${index + 1}:${line}`);
    });
  }
  return hits;
}

function printLines(lines) {
  if (lines.length > 0) process.stdout.write(lines.join('\n') + '\n');
}

function main(argv) {
  const root = resolveRoot();
  const hiddenPatterns = loadHiddenPatterns();
  const [command, ...args] = argv;

  try {
    switch (command) {
      case 'ls':
        printLines(listDirectory(root, hiddenPatterns, args[0] ?? '.'));
        return;
      case 'read':
        if (!args[0]) usageError();
        process.stdout.write(readFile(root, hiddenPatterns, args[0]));
        return;
      case 'grep':
        if (!args[0]) usageError();
        printLines(grepFiles(root, hiddenPatterns, args[0], args[1] ?? '.'));
        return;
      default:
        usageError();
    }
  } catch (err) {
    if (err instanceof NoSuchFileError) {
      process.stderr.write(`files-gateway: no such file: ${err.message}\n`);
      process.exit(1);
    }
    throw err;
  }
}

main(process.argv.slice(2));
